# Copy to .env and adjust. Used by docker-compose.

# --- Database ---
POSTGRES_DB=calendarit
POSTGRES_USER=calendarit
POSTGRES_PASSWORD=changeme

# --- Auth (REQUIRED) ---
# Must be at least 32 characters. Generate a strong random value, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ISSUER=calendarit
JWT_AUDIENCE=calendarit

# --- Accounts ---
# Close public sign-up once everyone who needs an account has one. Existing accounts keep
# working; the Register tab disappears from the sign-in screen.
DISABLE_REGISTRATION=false
# Origin used to build password-reset links — REQUIRED for self-service password reset.
# It is never taken from the request: Host is a header, and the forgot-password endpoint is
# anonymous, so anyone could otherwise have a real reset link mailed to a host of their choosing.
# Leave it unset and reset links simply aren't sent (the server logs why); everything else works.
PUBLIC_BASE_URL=https://calendar.example.com

# --- Behind your reverse proxy ---
# How many X-Forwarded-For hops to trust when working out the client's IP (used by the auth
# rate limit and the request log). 1 = your proxy talks to the app directly (this compose
# file). 2 = the single-container image, where your proxy fronts the container's nginx.
FORWARDED_PROXY_HOPS=1
# Auth requests (login/register/refresh) allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Browser notifications (Web Push) ---
# Optional. If left unset, a VAPID key pair is generated on first start and persisted under
# APPDATA_PATH (vapid.json), so browser reminders work with zero config. Set both to keep the
# same keys across separate deployments (existing browser subscriptions stay valid). Generate
# a pair with any web-push VAPID tool. VAPID_SUBJECT is a contact URI shown to push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@calendar.example.com

# --- Email ---
# There are no SMTP settings here. Email (invitations and reminders) is sent through each
# user's own mail account, connected in the app under Settings → Email. When a user hasn't
# connected one, their reminders are logged instead of sent.
