# Copy to .env and adjust. Used by docker-compose.

# --- Database ---
POSTGRES_DB=calendarit
POSTGRES_USER=calendarit
# REQUIRED. Generate one, e.g.: openssl rand -hex 24 (hex: no ; or = to upset the connection string).
# Postgres takes it only when it initializes an empty data volume. Changing it later does not
# change the database's password — see README, "Database password".
POSTGRES_PASSWORD=

# --- Auth (REQUIRED) ---
# Must be at least 32 characters. Generate a strong random value, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ISSUER=calendarit
JWT_AUDIENCE=calendarit

# --- Accounts ---
# Close public sign-up once everyone who needs an account has one. Existing accounts keep
# working; the Register tab disappears from the sign-in screen.
DISABLE_REGISTRATION=false
# Origin used to build password-reset links — REQUIRED for self-service password reset.
# It is never taken from the request: Host is a header, and the forgot-password endpoint is
# anonymous, so anyone could otherwise have a real reset link mailed to a host of their choosing.
# Leave it unset and reset links simply aren't sent (the server logs why); everything else works.
PUBLIC_BASE_URL=https://calendar.example.com

# --- Behind your reverse proxy ---
# How many X-Forwarded-For hops to trust when working out the client's IP (used by the auth
# rate limit and the request log). 1 = your proxy talks to the app directly (this compose
# file). 2 = the single-container image, where your proxy fronts the container's nginx.
FORWARDED_PROXY_HOPS=1
# Auth requests (login/register/refresh) allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20
# All other API/CalDAV requests per account (per IP before sign-in) per minute, with bursts up to
# the same number. 0 turns the limit off.
API_RATE_LIMIT_PER_MINUTE=1200
# Optional. Comma-separated networks the reverse proxy connects from (e.g. 172.16.0.0/12). Set it
# when anything but your proxy can reach the app's port: only these are believed about the
# client address. Unset = any direct peer is.
FORWARDED_TRUSTED_NETWORKS=

# --- Per-account limits (optional; shown with their defaults) ---
# QUOTA_EVENTS=100000
# QUOTA_TASKS=20000
# QUOTA_CALENDARS=50
# QUOTA_SUBSCRIPTIONS=10
# QUOTA_CATEGORIES=200

# --- Browser notifications (Web Push) ---
# Optional. If left unset, a VAPID key pair is generated on first start and persisted under
# APPDATA_PATH (vapid.json), so browser reminders work with zero config. Set both to keep the
# same keys across separate deployments (existing browser subscriptions stay valid). Generate
# a pair with any web-push VAPID tool. VAPID_SUBJECT is a contact URI shown to push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@calendar.example.com

# --- Email ---
# Invitations and reminders are sent through each user's own mail account, connected in the
# app under Settings → Email. When a user hasn't connected one, their reminders are logged
# instead of sent.
# Where those mail servers may live: private (internet + LAN, never this server or link-local),
# public (internet only), or any. Unset = public while sign-up is open, private once
# DISABLE_REGISTRATION=true (a stranger's account mustn't reach into your network).
MAIL_HOST_POLICY=

# --- Server mail account (optional) ---
# Account mail only: activation links for new sign-ups, and password resets (preferred over the
# user's own account). Needs PUBLIC_BASE_URL. New accounts can't sign in until activated; without
# a server mail account the admin (the first account) activates them in Settings → Users,
# or you run:  dotnet calendarITCore.dll activate-account user@example.com
# SMTP_USE_SSL: true = TLS on connect (port 465), false = STARTTLS (default unless port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=24seven <noreply@calendar.example.com>
