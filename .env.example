# Copy to .env and adjust. Used by docker-compose.

# --- Database ---
POSTGRES_DB=calendarit
POSTGRES_USER=calendarit
POSTGRES_PASSWORD=changeme

# --- Auth (REQUIRED) ---
# Must be at least 32 characters. Generate a strong random value, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ISSUER=calendarit
JWT_AUDIENCE=calendarit

# --- Behind your reverse proxy ---
# How many X-Forwarded-For hops to trust when working out the client's IP (used by the auth
# rate limit and the request log). 1 = your proxy talks to the app directly (this compose
# file). 2 = the single-container image, where your proxy fronts the container's nginx.
FORWARDED_PROXY_HOPS=1
# Auth requests (login/register/refresh) allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Email ---
# There are no SMTP settings here. Email (invitations and reminders) is sent through each
# user's own mail account, connected in the app under Settings → Email. When a user hasn't
# connected one, their reminders are logged instead of sent.
