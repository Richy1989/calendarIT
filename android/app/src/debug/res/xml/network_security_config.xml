<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (this file replaces the main one there): plain http reaches a dev backend
     (the emulator's host is 10.0.2.2:5299), and user-installed CAs vouch for a self-signed test
     server. Release builds use src/main's https-only config. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
