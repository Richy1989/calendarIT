<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds speak https only: the password and tokens travel on every sign-in. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
