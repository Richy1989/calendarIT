<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to another device: the tokens are sealed with a key that
     never leaves this one, and the calendar comes back from the server on sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
